CTPATH_DB_URL=mysql+pymysql://root:root@127.0.0.1:3306/ctpath?charset=utf8mb4
CTPATH_ALLOW_DEMO_FALLBACK=0

# DeepSeek is disabled by default to avoid automatic quota usage.
# Set CTPATH_LLM_ENABLED=1 and DEEPSEEK_API_KEY only for manual remote advice.
CTPATH_LLM_ENABLED=0
CTPATH_LLM_REMOTE_ON_PREDICT=0
CTPATH_LLM_MIN_INTERVAL=300
CTPATH_LLM_CACHE_TTL=3600
CTPATH_LLM_CACHE_MAX_ITEMS=256
