        <mxCell id="drug_save" value="保存药品基础数据" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="180" y="530" width="170" height="42" as="geometry" />
        </mxCell>
        <mxCell id="permission_save" value="保存权限配置" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="760" y="530" width="170" height="42" as="geometry" />
        </mxCell>
        <mxCell id="support" value="支撑当前用药展示、&#xa;用药充分性评估和角色级药品控制" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="400" y="625" width="300" height="58" as="geometry" />
