        </mxCell>
        <mxCell id="pharmacist" value="药师进入药品目录管理" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="170" y="325" width="190" height="42" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="管理员进入药品权限管理" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="740" y="325" width="210" height="42" as="geometry" />
        </mxCell>
        <mxCell id="drug_info" value="维护药品目录&#xa;通用名 / 剂型规格 / 状态&#xa;处方药标识 / 管制药标识" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="140" y="415" width="250" height="72" as="geometry" />
