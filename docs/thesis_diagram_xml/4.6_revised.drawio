<mxfile host="app.diagrams.net">
  <diagram id="drug_flow_424_revised" name="4.2.4药事管理模块流程图-修订版">
    <mxGraphModel dx="980" dy="715" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="用户登录" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="495" y="35" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="enter" value="进入药事管理入口" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="460" y="105" width="180" height="42" as="geometry" />
        </mxCell>
        <mxCell id="role" value="当前角色是否匹配&#xa;药事业务入口" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="485" y="180" width="130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="deny" value="返回无权限提示" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=13;" vertex="1" parent="1">
