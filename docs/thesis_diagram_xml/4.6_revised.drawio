        <mxCell id="permission_info" value="配置药品权限矩阵&#xa;查看 / 开立 / 审核 / 执行&#xa;管制药操作范围" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="415" width="250" height="72" as="geometry" />
