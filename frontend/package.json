{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native -c vite.config.mjs",
    "build": "vue-tsc -b && vite build --configLoader native -c vite.config.mjs",
    "preview": "vite preview --configLoader native -c vite.config.mjs",
    "dev:model": "set CTPATH_APP_TARGET=model && vite --configLoader native -c vite.config.mjs",
    "build:model": "set CTPATH_APP_TARGET=model && vite build --configLoader native -c vite.config.mjs",
    "preview:model": "set CTPATH_APP_TARGET=model && vite preview --configLoader native -c vite.config.mjs",
    "test": "vitest run --config vitest.config.ts --configLoader runner"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.8.4",
    "echarts": "^5.6.0",
    "element-plus": "^2.8.8",
    "pinia": "^2.3.1",
    "vue": "^3.5.25",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.5"
  }
}
